# Copy to `.env` and fill in the blanks. `.env` is gitignored; never commit it.
#
# Authentication fails closed: with JWT_SECRET_KEY missing or blank every
# /api/v1/auth/* route answers 503 and no token can be issued or verified.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
APP_NAME=ALgotwin API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./algotwin.db
AUTO_CREATE_TABLES=true
# DEMO ACCOUNT IS OFF BY DEFAULT. The demo login
# (`learner@algotwin.dev` / a password published in `database/seed.py`) is a
# convenience for local development and a hand-out of a login to everyone on a
# public deployment. Set SEED_DEMO_DATA=true only after deciding that is
# acceptable for where this runs.
SEED_DEMO_DATA=false
# Comma-separated list. The Vite dev server runs on 5174 (see frontend/vite.config.js).
# `localhost` and `127.0.0.1` are the same server but separate CORS origins; allow both.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Required. Signs and verifies every access token. At least 32 characters;
# a shorter value is refused the same way a blank one is (auth routes 503).
# Rotating it invalidates every issued token and signs all learners out.
JWT_SECRET_KEY=
# HS256 | HS384 | HS512
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes. Allowed range 1-10080.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Failed-attempt throttling for the unauth hashing endpoints (/auth/login,
# /auth/register). ON by default. Login counts failures per (email, client IP);
# registration counts attempts per client IP. When a budget is exhausted the
# route answers 429 with Retry-After. Set to false only if an upstream proxy
# already throttles these routes.
AUTH_THROTTLE_ENABLED=true
AUTH_MAX_LOGIN_FAILURES=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_MAX_REGISTRATIONS=15
AUTH_REGISTER_WINDOW_SECONDS=3600

AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Problem catalog. On startup the seed validates every definition against the
# language registry (reference solutions are executed) and then upserts, so
# existing problem IDs, attachments and `is_published` survive a reseed.
SEED_PROBLEM_CATALOG=true

# Code execution. OFF by default, and switching it on is not enough on its own:
# a run or submission still answers 503 until an isolation decision is recorded.
#
#   EXECUTION_ENABLED=true            -- operator intent
#   EXECUTION_ISOLATION=none          -- backend currently registered
#   EXECUTION_ALLOW_INSECURE_NATIVE=true -- EXPLICIT and NOT recommended for a
#                                          public deployment. Acknowledges that
#                                          the native supervisor provides NO
#                                          OS-level isolation: no container, no
#                                          sandbox, no memory/CPU limits on
#                                          Windows, no network/fs confinement.
#                                          Only for a trusted host or a test
#                                          runner.
#
# With the safe defaults below, /judge/languages reports execution_enabled=false
# and /problems/{id}/run and /submissions answer 503 without starting a process.
# /judge/languages still lists the languages the registry can run; the editor
# uses execution_enabled to decide whether to offer a Run button.
EXECUTION_ENABLED=false
EXECUTION_ISOLATION=none
EXECUTION_ALLOW_INSECURE_NATIVE=false
EXECUTION_PYTHON=true
EXECUTION_JAVASCRIPT=true
# Ceiling on the wall clock of a single Run request, whatever limits a problem
# asks for. Per-case time is clamped to this budget so one request cannot
# multiply the problem's limit by its case count. Allowed range 1000-600000.
MAX_JUDGE_WALL_CLOCK_MS=30000

# Documentation only. Vite's envDir is `frontend/`, so the value the frontend
# actually reads is VITE_API_URL in `frontend/.env`.
VITE_API_URL=http://localhost:8001/api/v1
