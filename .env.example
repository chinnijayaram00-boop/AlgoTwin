# Copy to `.env` and fill in the blanks. `.env` is gitignored; never commit it.
#
# Authentication fails closed: with JWT_SECRET_KEY missing or blank every
# /api/v1/auth/* route answers 503 and no token can be issued or verified.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
APP_NAME=ALgotwin API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./algotwin.db
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173

# Required. Signs and verifies every access token. Rotating it invalidates
# every issued token and signs all learners out.
JWT_SECRET_KEY=
# HS256 | HS384 | HS512
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes. Allowed range 1-10080.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Read by the Vite frontend at build/dev time.
VITE_API_URL=http://localhost:8000/api/v1
